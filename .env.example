# GEMINI_API_KEY: Required for Gemini AI API calls (WasteGuard AI assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database file path (defaults to ./urban_waste_management.db)
DATABASE_PATH="./urban_waste_management.db"

# Session signing secret (auto-generated fallback used locally if omitted)
SESSION_SECRET="CHANGE_ME_MUNICIPAL_SESSION_SECRET"
